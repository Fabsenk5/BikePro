# BikePro Environment Variables
# Copy to .env and fill in your Supabase credentials

# Supabase (https://supabase.com → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenWeatherMap (https://openweathermap.org → free API key, 1000 calls/day)
# Used by the Park-Picker for live weather. Without it, weather shows "no live data".
EXPO_PUBLIC_OPENWEATHER_KEY=

# GitHub Actions (Park-Picker daily lift-status scraper) — set as repo secrets:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY (Supabase → Project Settings → API → service_role)
